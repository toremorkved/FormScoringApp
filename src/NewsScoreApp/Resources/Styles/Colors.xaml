<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Accent -->
    <Color x:Key="Accent">#0A84FF</Color>

    <!-- Neutral surfaces, light theme (iOS systemGroupedBackground family) -->
    <Color x:Key="BackgroundLight">#F2F2F7</Color>
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="InputBackgroundLight">#FFFFFF</Color>
    <Color x:Key="InputBorderLight">#D1D1D6</Color>
    <Color x:Key="ChipInactiveBackgroundLight">#E5E5EA</Color>
    <Color x:Key="ChipInactiveTextLight">#3C3C43</Color>
    <Color x:Key="ChoiceUnselectedBackgroundLight">#F2F2F7</Color>
    <Color x:Key="ChoiceSelectedBackgroundLight">#E5F1FF</Color>
    <Color x:Key="TextPrimaryLight">#000000</Color>
    <Color x:Key="TextSecondaryLight">#6C6C70</Color>
    <Color x:Key="SeparatorLight">#E5E5EA</Color>

    <!-- Neutral surfaces, dark theme -->
    <Color x:Key="BackgroundDark">#000000</Color>
    <Color x:Key="CardBackgroundDark">#1C1C1E</Color>
    <Color x:Key="InputBackgroundDark">#1C1C1E</Color>
    <Color x:Key="InputBorderDark">#38383A</Color>
    <Color x:Key="ChipInactiveBackgroundDark">#2C2C2E</Color>
    <Color x:Key="ChipInactiveTextDark">#EBEBF5</Color>
    <Color x:Key="ChoiceUnselectedBackgroundDark">#2C2C2E</Color>
    <Color x:Key="ChoiceSelectedBackgroundDark">#12283F</Color>
    <Color x:Key="TextPrimaryDark">#FFFFFF</Color>
    <Color x:Key="TextSecondaryDark">#8E8E93</Color>
    <Color x:Key="SeparatorDark">#38383A</Color>

    <!-- Risk / score semantic colors: theme-invariant (mirrors the prototype, which keeps
         the same green/amber/orange/red across light & dark) -->
    <Color x:Key="RiskLowColor">#34C759</Color>
    <Color x:Key="RiskLowMediumColor">#FFCC00</Color>
    <Color x:Key="RiskMediumColor">#FF9500</Color>
    <Color x:Key="RiskHighColor">#FF3B30</Color>
    <Color x:Key="RiskNeutralColor">#8E8E93</Color>
    <Color x:Key="ChipScoreOneColor">#FFCC00</Color>

    <Color x:Key="RiskLowBackground">#1934C759</Color>
    <Color x:Key="RiskLowMediumBackground">#19FFCC00</Color>
    <Color x:Key="RiskMediumBackground">#19FF9500</Color>
    <Color x:Key="RiskHighBackground">#19FF3B30</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS-only native app -->
		<TargetFrameworks>net11.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>NewsScoreApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>


		<!-- Display name -->
		<ApplicationTitle>NEWS Score</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.dipsas.newsscoreapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<!-- iOS 26-era deployment target -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0A84FF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A84FF" BaseSize="180,180" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<PropertyGroup>
		<AzureOpenAiEndpoint Condition="'$(AzureOpenAiEndpoint)' == ''">$([System.Environment]::GetEnvironmentVariable('AZURE_OPENAI_ENDPOINT'))</AzureOpenAiEndpoint>
		<AzureOpenAiDeployment Condition="'$(AzureOpenAiDeployment)' == ''">$([System.Environment]::GetEnvironmentVariable('AZURE_OPENAI_DEPLOYMENT'))</AzureOpenAiDeployment>
		<AzureOpenAiApiKey Condition="'$(AzureOpenAiApiKey)' == ''">$([System.Environment]::GetEnvironmentVariable('AZURE_OPENAI_API_KEY'))</AzureOpenAiApiKey>
	</PropertyGroup>

	<Target Name="GenerateAzureOpenAiBuildSettings" BeforeTargets="CoreCompile">
		<MakeDir Directories="$(IntermediateOutputPath)Generated" />
		<ItemGroup>
			<AzureOpenAiGeneratedLine Include="namespace NewsScoreApp.Services.AI%3B" />
			<AzureOpenAiGeneratedLine Include="internal static class AzureOpenAiBuildSettings" />
			<AzureOpenAiGeneratedLine Include="{" />
			<AzureOpenAiGeneratedLine Include="    public const string Endpoint = &quot;$(AzureOpenAiEndpoint)&quot;%3B" />
			<AzureOpenAiGeneratedLine Include="    public const string Deployment = &quot;$(AzureOpenAiDeployment)&quot;%3B" />
			<AzureOpenAiGeneratedLine Include="    public const string ApiKey = &quot;$(AzureOpenAiApiKey)&quot;%3B" />
			<AzureOpenAiGeneratedLine Include="}" />
		</ItemGroup>
		<WriteLinesToFile
			File="$(IntermediateOutputPath)Generated/AzureOpenAiBuildSettings.g.cs"
			Overwrite="true"
			Lines="@(AzureOpenAiGeneratedLine)" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)Generated/AzureOpenAiBuildSettings.g.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="CrossIntelligence" Version="0.6.59" />
		<!-- CrossIntelligence already pulls this in transitively (it uses JSchemaGenerator to turn
		     .NET types into JSON Schemas for guided generation), but we reference it explicitly so
		     we can also build our own schema (with SchemaReferenceHandling.None) for RespondAsync<T>. -->
		<PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.6.*" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

</Project>
